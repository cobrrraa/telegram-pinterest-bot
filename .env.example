# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Твой Telegram ID (узнать у @userinfobot) — бот отвечает только тебе
ALLOWED_USER_ID=
# URL webhook'а из сценария Make (модуль Custom webhook)
MAKE_WEBHOOK_URL=
# Любая длинная случайная строка; та же строка вписывается в фильтр сценария Make
MAKE_SECRET=
# Префикс пути к API. Если модуль "Make an API Call" уже подставляет /v5 сам — оставь пустым
PINTEREST_PATH_PREFIX=/v5
# Где бот хранит своё состояние (последнюю выбранную доску)
DATA_DIR=data
# Пауза между пинами в минутах (чаще — Pinterest включает антиспам)
PIN_INTERVAL_MINUTES=5
# Первая пауза после антиспама (минуты) и максимальная (часы)
BACKOFF_START_MINUTES=60
BACKOFF_MAX_HOURS=6

# CSV image hosting (set your own public URL)
PUBLIC_BASE_URL=https://photos.example.com/p
PUBLIC_DIR=public
FILES_PORT=80
